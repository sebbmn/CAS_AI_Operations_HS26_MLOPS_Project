# Copy to .env and fill in your own values.
# API key: hopsworks.ai -> Account Settings -> API keys (scopes: project, featurestore, job, kafka)
HOPSWORKS_API_KEY=REPLACE_WITH_YOUR_HOPSWORKS_API_KEY
HOPSWORKS_PROJECT=REPLACE_WITH_YOUR_HOPSWORKS_PROJECT_NAME

# Location used for the weather data (default: Zurich, Switzerland)
CITY=zurich
LATITUDE=47.3769
LONGITUDE=8.5417

# How many days of history the feature pipeline backfills
HISTORY_DAYS=365
